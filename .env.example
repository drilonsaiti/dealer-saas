APP_NAME="Dealer SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_CH
APP_TIMEZONE=Europe/Zurich

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The app must connect as a role WITHOUT superuser and WITHOUT BYPASSRLS,
# otherwise PostgreSQL Row-Level Security is silently skipped.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dealer
DB_USERNAME=dealer
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local: "sync" runs jobs (reading scanned text, imports) immediately, no worker needed.
# Production: "redis" with the queue services of deploy/docker-compose.prod.yml.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.ch"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ch-gva-2
AWS_ENDPOINT=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOTENBERG_URL=http://127.0.0.1:3000

# Required everywhere by default (see config/dealer.php). Uncomment only in your own local
# .env if two-factor setup is getting in the way of manual testing.
# DEALER_ENFORCE_MFA=false

# Production only (deploy/docker-compose.prod.yml and deploy/backup.sh)
DOMAIN=
POSTGRES_SUPERUSER_PASSWORD=
BACKUP_REMOTE=
BACKUP_FILES_SOURCE=
BACKUP_KEEP_DAYS=30

# Imports: in production set to redis-long (worked by the queue-long service); empty = default queue
IMPORT_QUEUE_CONNECTION=
